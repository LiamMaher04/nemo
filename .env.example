# Copy to .env and fill in. .env is gitignored. Never commit real keys (this repo is public).

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Nemotron (default: NVIDIA API, OpenAI-compatible)
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_API_KEY=
# Agent brain: fast, built for tool calling
NEMOTRON_AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Looks at snapshots (describe_snapshot tool). Copy the exact ID from build.nvidia.com
NEMOTRON_VL_MODEL=
# Thinking slows spoken answers. Off for quick where_is answers, on for multi-step carer questions.
NEMOTRON_THINKING=false
# Fallback: OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=

# SpacetimeDB (local for the demo; Maincloud for cloud mode)
# Maincloud database (already created). Local dev: http://localhost:3000
SPACETIME_URL=https://maincloud.spacetimedb.com
SPACETIME_DB=nemodb-g8356
SPACETIME_TOKEN=

# Vision
DETECTOR=yoloe            # yoloe | yolo_world
DETECTOR_WEIGHTS=
DETECT_CONF=0.25
FRAME_MIN_WIDTH=1280

# Photon carer texts (notifier/). Project ID and secret from app.photon.codes > Settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
CARER_PHONE=              # E.164, e.g. +15551234567; add it as a User in the Photon dashboard
NOTIFIER_PORT=8100

# Speech
STT_MODEL=small.en        # faster-whisper
TTS_PROVIDER=             # elevenlabs | local
ELEVENLABS_API_KEY=
