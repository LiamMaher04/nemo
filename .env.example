# Copy to .env and fill in. .env is gitignored. Never commit real keys (this repo is public).

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Nemotron (default: NVIDIA API, OpenAI-compatible)
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-nano-12b-v2-vl
NEMOTRON_API_KEY=
# Fallback: OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_API_KEY=

# SpacetimeDB (local for the demo; Maincloud for cloud mode)
SPACETIME_URL=http://localhost:3000
SPACETIME_DB=nemo
SPACETIME_TOKEN=

# Vision
DETECTOR=yoloe            # yoloe | yolo_world
DETECTOR_WEIGHTS=
DETECT_CONF=0.25
FRAME_MIN_WIDTH=1280
STATIONARY_FRAMES=3

# Speech
STT_MODEL=small.en        # faster-whisper
TTS_PROVIDER=             # elevenlabs | local
ELEVENLABS_API_KEY=
