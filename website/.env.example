# Public URL of the deployed site (used for Open Graph / canonical links).
# TODO: set this to your real domain once you have one.
NEXT_PUBLIC_SITE_URL=https://nemo.example.com

# Optional: where the waitlist form should send sign-ups.
# TODO: point this at a real service (Formspree, Resend, Airtable, etc.).
# If unset, the built-in /api/waitlist placeholder handler is used.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Inbox for the mailto: fallback if the form can't be sent.
# TODO: replace with the team's real address.
NEXT_PUBLIC_CONTACT_EMAIL=hello@nemo.example.com
